# Copiar a .env y completar. .env está en .gitignore: nunca commitear keys.
# Clave de OpenAI solo para embeddings (text-embedding-3-small). La leen únicamente los
# embeddings; los clientes de chat no la ven.
OPENAI_EMBEDDINGS_API_KEY=
# Opcional: clave de OpenAI para chat. Solo hace falta para re-correr la ablación con GPT-4.1 o
# configs cuyo multi-query/rerank/visión sean modelos de OpenAI fuera de caché.
# OPENAI_API_KEY=
# Credencial de la API de Anthropic: razonador (Claude Sonnet 5.5), planner (Claude Haiku 5.5)
# y juez del plan. También se acepta ANTHROPIC_API_KEY.
CLAUDE_API_KEY=

# Opcional (Fase 5, recién después del gate G2). Solo con el golden, nunca con datos reales.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=safefish

# Opcional: User-Agent para los loaders web de la ingesta.
# USER_AGENT=safefish-ingest/0.1
